{
  "name": "journeys_backend",
  "version": "1.0.0",
  "main": "build/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node -r dotenv/config build/server.js",
    "dev": "ts-node-dev --respawn -r dotenv/config src/server.ts",
    "migration:generate": "ts-node-dev ./node_modules/.bin/typeorm migration:generate -d ./src/services/typeorm/index.ts",
    "migration:up": "ts-node-dev ./node_modules/.bin/typeorm migration:run -d ./src/services/typeorm/index.ts",
    "migration:down": "ts-node-dev ./node_modules/.bin/typeorm migration:revert -d ./src/services/typeorm/index.ts",
    "migration-deploy:up": "typeorm migration:run -d ./build/services/typeorm/index.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/storage": "^7.7.0",
    "@google-cloud/translate": "^8.1.0",
    "@googlemaps/google-maps-services-js": "^3.3.42",
    "@sendgrid/mail": "^8.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.14",
    "@types/express": "^4.17.19",
    "@types/express-fileupload": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/lodash": "^4.14.202",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.7",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.7",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-fileupload": "^1.4.3",
    "helmet": "^7.0.0",
    "joi": "17.7.0",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "morgan": "^1.10.0",
    "mysql2": "^3.6.5",
    "rate-limiter-flexible": "^3.0.4",
    "reflect-metadata": "^0.2.1",
    "string-similarity-js": "^2.1.4",
    "swagger-ui-express": "^5.0.0",
    "tsyringe": "^4.8.0",
    "typeorm": "^0.3.19",
    "typeorm-naming-strategies": "^4.1.0",
    "typescript": "^5.3.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.7.5",
    "@typescript-eslint/parser": "^6.7.5",
    "eslint": "^8.51.0",
    "ts-node-dev": "^2.0.0"
  }
}
